# Copy this file to .env and fill in the real values.
# .env is gitignored — safe to put real URLs/secrets there.

# Port the CRM/scraper dashboard runs on (optional, defaults to 3000)
PORT=3000

# Per-niche demo site URLs — set each one once that niche's site is deployed
# on Netlify. See src/config/nicheDemoSites.js for how these are used, and
# PROJECT_CONTEXT.md §6 for the full deploy walkthrough.
DEMO_BASE_URL_DENTAL=
